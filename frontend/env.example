# Copy to frontend/.env.local for local dev, or add these in Vercel → Project → Settings → Environment Variables

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Deployed backend URL (no trailing slash), e.g. https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
